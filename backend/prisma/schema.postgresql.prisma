datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  passwordHash     String
  name             String
  role             String      @default("STUDENT")
  department       String?
  usn              String?     @unique
  avatarUrl        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organizedEvents  Event[]     @relation("EventOrganizer")
  bookings         Booking[]
  validatedTickets Ticket[]    @relation("TicketValidator")
  auditLogs        AuditLog[]

  @@index([role])
}

model Event {
  id                String      @id @default(uuid())
  title             String
  description       String
  category          String      @default("TECHNICAL")
  venue             String
  startDateTime     DateTime
  endDateTime       DateTime
  totalCapacity     Int
  availableCapacity Int
  status            String      @default("DRAFT")
  bannerUrl         String?
  organizerId       String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organizer         User        @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  bookings          Booking[]

  @@index([status])
  @@index([category])
  @@index([startDateTime])
}

model Booking {
  id               String      @id @default(uuid())
  bookingReference String      @unique
  userId           String
  eventId          String
  status           String      @default("CONFIRMED")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket           Ticket?

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Ticket {
  id            String      @id @default(uuid())
  ticketCode    String      @unique
  qrPayload     String      @unique
  bookingId     String      @unique
  status        String      @default("VALID")
  validatedAt   DateTime?
  validatedById String?
  entryNotes    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  validatedBy   User?       @relation("TicketValidator", fields: [validatedById], references: [id], onDelete: SetNull)

  @@index([ticketCode])
  @@index([qrPayload])
  @@index([status])
}

model AuditLog {
  id         String      @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  userId     String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
}
