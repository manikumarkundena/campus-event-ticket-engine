# ============================================================
# Campus Event Ticketing Engine - Environment Variables
# Siddaganga Institute of Technology - SPM ABL-1 Project
# ============================================================

# Application Environment (development | production | test)
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL in production/Docker, SQLite for rapid local dev)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_tickets?schema=public"

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# Frontend Next.js Public Environment
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional AI Assistant (Gemini API for event metadata generation)
# GEMINI_API_KEY=your_gemini_api_key_here

# Container Registry & Deployment (for CI/CD pipeline)
DOCKER_REGISTRY=ghcr.io
IMAGE_TAG=latest
